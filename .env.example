# ---------------------------------------------------------------------------
# Core (required)
# ---------------------------------------------------------------------------
# Postgres connection string (Neon: use the pooled connection string).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Signs Payload sessions. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=
# Public origin of the app. Embedded in PDF QR codes, so keep it stable once credentials are issued.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated extra origins trusted for CORS/CSRF (optional).
EXTRA_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Credential PDF storage (required)
# ---------------------------------------------------------------------------
# AES-256-GCM key for stored PDFs. Generate with: openssl rand -hex 32
PASSPORT_STORAGE_KEY=
# Defaults to ./storage/passports locally and the OS temp dir on Vercel.
PASSPORT_STORAGE_DIR=

# ---------------------------------------------------------------------------
# Ledger
# ---------------------------------------------------------------------------
# demo: Postgres hash-chained, signed ledger. Instant, no wallet or tokens needed (default).
# amoy: real transactions on Polygon Amoy via the server-side relayer wallet below.
LEDGER_MODE=demo
# Optional demo-ledger signing key (0x + 64 hex chars). Derived from PAYLOAD_SECRET when unset.
LEDGER_SIGNING_KEY=

# Only needed when LEDGER_MODE=amoy
BLOCKCHAIN_RPC_URL=
NEXT_PUBLIC_CONTRACT_ADDRESS=
# Server-side relayer wallet that owns the deployed contract. Never expose this.
ISSUER_PRIVATE_KEY=
# Trusted address the public verifier compares against the contract owner.
BTU_ISSUER_ADDRESS=

# ---------------------------------------------------------------------------
# Demo mode
# ---------------------------------------------------------------------------
# Enables the 1-click "Login as Demo Admin / Student" buttons and automatic cleanup.
DEMO_MODE=false
DEMO_ADMIN_EMAIL=demo.admin@example.com
# 12+ characters. Generate with: openssl rand -base64 18
DEMO_ADMIN_PASSWORD=
DEMO_STUDENT_EMAIL=demo.student@example.com
DEMO_STUDENT_PASSWORD=
# Visitor-issued credentials are removed once the oldest is this many minutes old.
DEMO_RESET_AFTER_MINUTES=60
# Authenticates the scheduled cleanup request (Vercel Cron sends it as a Bearer token).
CRON_SECRET=

# ---------------------------------------------------------------------------
# Administrator bootstrap (used by `npm run bootstrap:admin`)
# ---------------------------------------------------------------------------
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Development only
# ---------------------------------------------------------------------------
# Extra hostnames allowed to load the dev server (for example a LAN IP or tunnel host).
DEV_ALLOWED_HOSTS=
